# Copie para .env e preencha. NUNCA versione o .env.

# Usuário do GitHub cujos repositórios serão listados
VITE_GITHUB_USER=RafaelYutaNischida

# Supabase (Project Settings > API). A anon key é pública por design;
# a segurança vem das políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Secrets da Edge Function (NÃO usam prefixo VITE_ e NÃO vão para o front) ---
# Configure com: supabase secrets set RESEND_API_KEY=... OWNER_EMAIL=...
# RESEND_API_KEY=
# OWNER_EMAIL=
# RESEND_FROM="Portfolio <onboarding@resend.dev>"
# ALLOWED_ORIGIN=https://seu-dominio.vercel.app
